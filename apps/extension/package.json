{
  "name": "@window-resizer/extension",
  "displayName": "Window Resizer",
  "version": "0.1.0",
  "description": "Resize browser windows to exact pixel dimensions. Multi-window support, custom presets, and an optional match-inner-height mode.",
  "author": "Luan Gjokaj",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cherry-styled-components": "^0.2.16",
    "plasmo": "^0.90.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "styled-components": "^6.5.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/node": "^26",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "manifest": {
    "minimum_chrome_version": "116",
    "offline_enabled": true,
    "permissions": [
      "tabs",
      "storage",
      "scripting"
    ],
    "optional_host_permissions": [
      "http://*/*",
      "https://*/*"
    ],
    "action": {
      "default_title": "Window Resizer"
    }
  }
}
