{
  "name": "window-resizer",
  "version": "0.1.0",
  "private": true,
  "description": "Window Resizer: a Manifest V3 browser extension that resizes browser windows to exact pixel dimensions, with multi-window support and custom presets.",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm -r --if-present --parallel run dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "biome lint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^26",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.21.0"
}
